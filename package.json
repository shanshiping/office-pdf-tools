{
  "name": "office-pdf-tools",
  "version": "1.0.0",
  "description": "本地 PDF 工具箱 - 压缩、合并、删页",
  "author": "shanshiping",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:all": "vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.office.pdf-tools",
    "productName": "PDF 工具箱",
    "copyright": "Copyright © 2026 shanshiping",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.wasm",
      "**/pdf.worker*",
      "**/tesseract/**",
      "**/tessdata/**"
    ],
    "mac": {
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF 工具箱",
      "uninstallDisplayName": "PDF 工具箱",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "background": "dmg-background.png",
      "icon": "icon.icns",
      "iconSize": 80,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 160,
          "y": 185,
          "type": "file"
        },
        {
          "x": 380,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "docx": "^9.7.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
